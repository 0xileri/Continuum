# Copy to .env and fill in. .env is gitignored — never commit real keys.

# ---- 0G ------------------------------------------------------------------------------
# Signs every 0G transaction: Compute settlement, Storage uploads, registry publishes.
# Read only by the Node bridge (og-bridge/), never by the Python engine.
# Fund it: https://faucet.0g.ai  (Galileo testnet)
OG_PRIVATE_KEY=

# testnet | mainnet. Moves RPC, explorer, storage indexer and dashboard links together.
# Defaults to testnet so no careless run spends real 0G — §9 Day 3 sequences testnet first.
CONTINUUM_OG_NETWORK=testnet

# Deployed ContinuumScoreRegistry. Written to deployments/<network>.json by the deploy script;
# this overrides it.
CONTINUUM_REGISTRY_ADDRESS=

# Pin a 0G Compute provider with an acknowledged TEE signer. Empty means "first available", which
# is fine for a demo and wrong for anything reproducible — the provider identity is part of what
# the attestation attests to. `node og-bridge/doctor.mjs` prints the export line.
CONTINUUM_OG_COMPUTE_PROVIDER=

# Set to 1 to make scoring also write to 0G Storage and the registry. Off by default: a backfill
# is ~168 re-scores, and having that spend gas by accident is a bad surprise.
# CONTINUUM_OG_PUBLISH=1

# Set to 1 to refuse to publish a score whose 0G Compute attestation did not verify.
# Set this for any run whose output will be shown as Integration Proof.
# CONTINUUM_OG_REQUIRE_ATTESTATION=1

# ---- Reasoning agent ------------------------------------------------------------------
# 0g-compute | anthropic | offline
CONTINUUM_LLM_BACKEND=0g-compute

# Only needed for CONTINUUM_LLM_BACKEND=anthropic (no attestation on that path).
ANTHROPIC_API_KEY=

# ---- Scorer ---------------------------------------------------------------------------
# quant (§5.1 weighted formula, the Wave 3 path) | structured (deferred LightGBM model, §3)
CONTINUUM_SCORER=quant
