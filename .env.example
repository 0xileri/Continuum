# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Claude API key for the reasoning agent (continuum/scoring/llm_agent.py).
# Without it the agent falls back to a deterministic offline fixture and tags
# every flag it produces with source="offline_fixture". See ASSUMPTIONS.md #8.
ANTHROPIC_API_KEY=

# Optional overrides. Defaults live in continuum/config.py.
# CONTINUUM_LLM_MODEL=claude-sonnet-5
# CONTINUUM_LLM_ESCALATION_MODEL=claude-opus-5
# CONTINUUM_DATA_DIR=data
